# Nuxt dev/build outputs
.output
.data
.nuxt
.nuxtrc
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea
.claude
nul

# Local env files
.env
.env.*
!.env.example

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# PWA service worker build artifacts
sw.*
workbox-*.js
workbox-*.js.map

# robots.txt is committed on purpose: its `Disallow: /` keeps the SPA out of
# search indexes. Listed then negated so a stray ignore rule cannot drop it.
public/robots.txt
!public/robots.txt

# Playwright
test-results/
playwright-report/
blob-report/

# playright-mcp
.playwright-mcp
scripts/

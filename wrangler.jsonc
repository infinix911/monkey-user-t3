{
  "name": "monkey-user-t3",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "cache": {
    "enabled": false
  },
  "exports": {
    "default": {
      "type": "worker",
      "cache": {
        "enabled": false
      }
    },
    "Shell": {
      "type": "worker",
      "cache": {
        "enabled": true
      }
    }
  },
  "kv_namespaces": [
    {
      "binding": "USERPAGE_CONFIG"
    }
  ]
}
